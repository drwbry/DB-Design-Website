---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/hub.css';
import { sanityClient } from '../lib/sanityClient';
import { urlFor } from '../lib/imageUrl';

interface TeamMember {
  name: string;
  title: string;
  photo?: object;
  bio?: string;
}

interface AboutPageData {
  heroHeadline?: string;
  heroSubtext?: string;
  whyTitle?: string;
  whyBody?: string[];
  howTitle?: string;
  howBody?: string;
  teamMembers?: TeamMember[];
  ctaHeadline?: string;
}

const aboutData = await sanityClient.fetch<AboutPageData | null>(
  `*[_type == "aboutPage"][0] {
    heroHeadline,
    heroSubtext,
    whyTitle,
    whyBody,
    howTitle,
    howBody,
    teamMembers[] {
      name,
      title,
      photo,
      bio
    },
    ctaHeadline
  }`
);

const heroHeadline = aboutData?.heroHeadline;
const heroSubtext = aboutData?.heroSubtext ?? "The Web Foundry is a community initiative based in Cincinnati. We use AI-powered development to rebuild outdated local business websites — priced to stay within reach, not to turn a profit. Just a better web for the businesses that make our neighborhoods special.";
const whyTitle = aboutData?.whyTitle ?? "Why we do this";
const whyBody = aboutData?.whyBody ?? [
  "Small businesses are the backbone of every community. They sponsor little league teams, know your name when you walk in, and make neighborhoods feel like home. But too often, their online presence doesn't reflect who they are — it's a website from 2009 that barely works on a phone.",
  "Meanwhile, technology has moved fast. AI tools now let us build in hours what used to take weeks. We think that speed should benefit the people who need it most — not just the ones who can afford a $10,000 redesign.",
];
const howTitle = aboutData?.howTitle ?? "How it works";
const howBody = aboutData?.howBody ?? "We call it AI vibe coding — using modern AI development tools to rapidly prototype, iterate, and ship polished websites. We pair with business owners to capture their vision and deliver a site that actually represents what they do. Every site is custom, and priced to stay within reach — not to turn a profit.";
const founder = (aboutData?.teamMembers ?? [
  { name: "Dreux Brys", title: "Founder, Norwood", photo: undefined, bio: "Cincinnati-based technologist passionate about putting modern tools to work for the community." },
])[0];
const ctaHeadline = aboutData?.ctaHeadline ?? "Know a business that deserves better?";
---
<BaseLayout
  title="About — The Web Foundry"
  description="The Web Foundry is a Cincinnati community initiative using AI vibe coding to rebuild outdated local business websites. Meet the founder behind the mission."
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </Fragment>

  <nav class="nav" id="nav">
    <div class="container nav__inner">
      <a href="/" class="nav__logo">
        <span class="nav__logo-mark">W</span>
        <span class="nav__logo-name">The Web Foundry</span>
      </a>
      <ul class="nav__links">
        <li><a href="/#work" class="nav__link">Our Work</a></li>
        <li><a href="/#process" class="nav__link">How It Works</a></li>
        <li><a href="/about" class="nav__link">About</a></li>
        <li><a href="/#contact" class="nav__cta">Get in Touch</a></li>
      </ul>
      <button class="nav__hamburger" id="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <main id="main-content">

    <section class="about-hero">
      <div class="container">
        <div class="about-hero__inner reveal">
          <div class="about-hero__dash" aria-hidden="true"></div>
          <span class="section-tag">About Us</span>
          <h1 class="about-hero__title">
            {heroHeadline ?? <>We build websites<br/>for the people<br/><em>who build communities.</em></>}
          </h1>
          <p class="about-hero__sub">{heroSubtext}</p>
        </div>
      </div>
    </section>

    <section class="about-founder">
      <div class="container">
        <div class="about-founder__inner reveal">
          <div class="about-founder__photo-wrap">
            {founder.photo
              ? <img class="about-founder__photo" src={urlFor(founder.photo as object).width(480).height(560).fit('crop').url()} alt={founder.name} />
              : <div class="about-founder__photo-placeholder" aria-label={`${founder.name} photo placeholder`}></div>
            }
          </div>
          <div class="about-founder__copy">
            <span class="section-tag">From This Community</span>
            <h2 class="about-founder__name">{founder.name}</h2>
            <p class="about-founder__role">{founder.title} · Cincinnati, OH</p>
            <p class="about-founder__quote">{founder.bio}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="about-why">
      <div class="container">
        <div class="about-why__inner reveal">
          <span class="section-tag">Our Mission</span>
          <h2 class="about-section-title">{whyTitle}</h2>
          {whyBody.map((para) => (
            <p class="about-body-text">{para}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="about-how">
      <div class="container">
        <div class="about-how__inner reveal">
          <span class="section-tag">Our Process</span>
          <h2 class="about-section-title">{howTitle}</h2>
          <p class="about-body-text">{howBody}</p>
        </div>
      </div>
    </section>

    <section class="about-cta">
      <div class="container">
        <div class="about-cta__inner reveal">
          <h2 class="about-cta__title">{ctaHeadline}</h2>
          <a href="/#contact" class="btn btn--primary">Get in Touch <span class="btn-arrow">→</span></a>
        </div>
      </div>
    </section>

  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__brand">
        <span class="footer__mark">W</span>
        <span class="footer__label">The Web Foundry · Cincinnati, OH</span>
      </div>
      <nav class="footer__links" aria-label="Footer">
        <a href="/#work">Work</a>
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
      </nav>
    </div>
  </footer>

  <style is:global>
    .about-hero {
      padding: 5rem 0 3.5rem;
      background: var(--ink);
    }
    .about-hero__dash {
      width: 40px;
      height: 3px;
      background: var(--accent);
      border-radius: 2px;
      margin-bottom: 1.25rem;
    }
    .about-hero__title {
      font-family: var(--ff-display);
      font-size: clamp(2rem, 4.5vw, 3.25rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--cream);
      margin: 0.75rem 0 1.25rem;
    }
    .about-hero__title em {
      color: var(--accent);
      font-style: italic;
    }
    .about-hero__sub {
      font-size: 1.05rem;
      color: var(--muted);
      line-height: 1.75;
      max-width: 620px;
    }

    /* Founder spotlight */
    .about-founder {
      padding: 3.5rem 0 4.5rem;
      background: var(--surface);
      border-top: 1px solid var(--hairline);
    }
    .about-founder__inner {
      display: flex;
      align-items: center;
      gap: 3rem;
    }
    .about-founder__photo-wrap {
      flex: 0 0 260px;
    }
    .about-founder__photo,
    .about-founder__photo-placeholder {
      width: 260px;
      height: 300px;
      border-radius: 16px;
      object-fit: cover;
      display: block;
      border: 1px solid var(--border-card);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }
    .about-founder__photo-placeholder {
      background: linear-gradient(135deg, var(--surface-raised), var(--accent-dim));
    }
    .about-founder__copy {
      flex: 1;
    }
    .about-founder__name {
      font-family: var(--ff-display);
      font-size: clamp(1.6rem, 3vw, 2.1rem);
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--cream);
      margin-bottom: 0.35rem;
    }
    .about-founder__role {
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.25rem;
    }
    .about-founder__quote {
      font-family: var(--ff-display);
      font-size: 1.25rem;
      font-style: italic;
      line-height: 1.55;
      color: var(--cream);
      max-width: 480px;
      position: relative;
      padding-left: 1.25rem;
      border-left: 2px solid var(--accent);
    }

    /* Why / How sections */
    .about-why,
    .about-how {
      padding: 4.5rem 0;
      border-top: 1px solid var(--hairline);
    }
    .about-why {
      background: var(--ink);
    }
    .about-how {
      background: var(--surface);
    }
    .about-why__inner,
    .about-how__inner {
      max-width: 720px;
    }
    .about-section-title {
      font-family: var(--ff-display);
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--cream);
      margin-bottom: 1.25rem;
    }
    .about-body-text {
      font-size: 0.98rem;
      color: var(--muted);
      line-height: 1.8;
      margin-bottom: 1rem;
    }
    .about-body-text:last-child {
      margin-bottom: 0;
    }
    .about-how__inner .about-body-text strong {
      color: var(--accent);
    }

    .about-cta {
      padding: 4.5rem 0;
      background: var(--surface-raised);
      border-top: 1px solid var(--hairline);
      text-align: center;
    }
    .about-cta__title {
      font-family: var(--ff-display);
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--cream);
      margin-bottom: 1.5rem;
    }

    @media (max-width: 768px) {
      .about-hero { padding: 3.5rem 0 2.5rem; }
      .about-founder { padding: 2.5rem 0 3rem; }
      .about-founder__inner { flex-direction: column; text-align: center; gap: 1.75rem; }
      .about-founder__quote { margin: 0 auto; text-align: left; }
      .about-why, .about-how { padding: 3rem 0; }
      .about-cta { padding: 3rem 0; }
    }
  </style>

  <script>
    import '../scripts/main.js';
  </script>
</BaseLayout>
